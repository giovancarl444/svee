# CORTEX workers + migrate runner. Runs TS directly via tsx (no build step).
FROM node:22-slim AS runtime
ENV CI=1
RUN corepack enable
WORKDIR /app

COPY . .
RUN pnpm install --frozen-lockfile

ENV NODE_ENV=production
# Overridden by the compose service (e.g. `pnpm db:migrate`, or `pnpm start:workers`).
CMD ["pnpm", "--filter", "@cortex/workers", "start"]
