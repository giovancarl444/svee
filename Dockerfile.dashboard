# CORTEX dashboard (Next.js 15). Self-contained image for the all-in-one stack.
FROM node:22-slim AS build
ENV CI=1
RUN corepack enable
WORKDIR /app

# Copy the whole workspace so pnpm can resolve every workspace package against
# the committed lockfile (frozen = reproducible; Constraint §7/§10).
COPY . .
RUN pnpm install --frozen-lockfile
# force-dynamic pages don't touch the DB at build; a placeholder URL is enough.
ENV DATABASE_URL=postgres://build:build@localhost:5432/build
RUN pnpm --filter @cortex/dashboard build

ENV NODE_ENV=production
EXPOSE 3000
# `next start` serves the production build (reads DATABASE_URL at request time).
CMD ["pnpm", "--filter", "@cortex/dashboard", "start"]
