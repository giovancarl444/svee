# pnpm — strict, reproducible installs (supply-chain hygiene, Constraint §7/§10)
# Exact versions on `pnpm add` so nothing drifts silently.
save-exact=true
# Fail if the lockfile would need to change in CI.
# (Set by CI via `pnpm install --frozen-lockfile`; kept here as the intent.)
link-workspace-packages=true
prefer-workspace-packages=true
# Do not auto-run dependency build scripts; only the allowlist in
# package.json#pnpm.onlyBuiltDependencies is permitted to run postinstall.
