# =============================================================================
# CORTEX — environment contract.  Copy to `.env` and fill in.  NEVER commit `.env`.
# Every secret here is SERVER-SIDE ONLY.  None of these are exposed to the browser
# bundle (no NEXT_PUBLIC_* secrets — Constraint §3).
# =============================================================================

# --- Core ---------------------------------------------------------------------
NODE_ENV=development
# Local timezone for "today"/"tomorrow" reasoning and the nightly brief cutoff.
CORTEX_TZ=America/New_York
# The evening hour (0-23, local) the nightly Tomorrow Plan runs.
CORTEX_BRIEF_HOUR=20
# How often the always-on scheduler runs an ingest→triage→escalate→loops cycle.
CORTEX_SYNC_INTERVAL_MIN=5

# --- Datastore (Postgres) -----------------------------------------------------
# In Docker Compose this points at the `db` service; locally, at your Postgres.
DATABASE_URL=postgres://cortex:cortex@localhost:5432/cortex
# Used by docker-compose to initialize the Postgres container.
POSTGRES_USER=cortex
POSTGRES_PASSWORD=change-me-in-a-real-env
POSTGRES_DB=cortex

# --- Encryption at rest (Constraint §5) --------------------------------------
# 32-byte key, base64. Encrypts message bodies at the column level.
# Generate: `openssl rand -base64 32`
# Keep this OUT of the DB and ideally in a separate secret store from the disk,
# so a stolen disk alone does not yield plaintext message bodies.
CORTEX_ENCRYPTION_KEY=

# --- Model provider (the ONLY model egress — Constraint §4) ------------------
# 'anthropic' = pinned Claude tiers. 'openai' = any OpenAI-compatible endpoint
# (local Ollama, or hosted DeepSeek / OpenRouter). Pick ONE profile below.
CORTEX_MODEL_PROVIDER=anthropic

# Profile A — Anthropic (best quality; needs a paid key):
ANTHROPIC_API_KEY=
CORTEX_MODEL_TRIAGE=claude-haiku-4-5-20251001
CORTEX_MODEL_ESCALATE=claude-sonnet-5
CORTEX_MODEL_SYNTHESIS=claude-opus-4-8

# Profile B — Ollama, fully local + free (recommended for getting started).
# `brew install ollama && ollama pull qwen2.5:7b-instruct` then:
#   CORTEX_MODEL_PROVIDER=openai
#   CORTEX_OPENAI_BASE_URL=http://localhost:11434/v1
#   CORTEX_OPENAI_API_KEY=ollama          # any non-empty value; Ollama ignores it
#   CORTEX_MODEL_TRIAGE=qwen2.5:7b-instruct
#   CORTEX_MODEL_ESCALATE=qwen2.5:7b-instruct
#   CORTEX_MODEL_SYNTHESIS=qwen2.5:7b-instruct   # or a bigger local model for the brief
# Use an INSTRUCTION model, not a reasoning one: the local benchmark (demo/benchmark.md)
# scored qwen2.5:7b-instruct 96% valid structured output vs qwen3 0% at ~9x latency —
# reasoning models are unfit for CORTEX's bounded tool-calls. gemma3:4b is a lighter
# alternative. Nothing leaves the machine — the strongest fit for the local-first rule.

# Profile C — DeepSeek, cheap hosted ($0.28/$0.42 per MTok; 5M free tokens on signup):
#   CORTEX_MODEL_PROVIDER=openai
#   CORTEX_OPENAI_BASE_URL=https://api.deepseek.com/v1
#   CORTEX_OPENAI_API_KEY=sk-...
#   CORTEX_MODEL_TRIAGE=deepseek-chat
#   CORTEX_MODEL_ESCALATE=deepseek-chat
#   CORTEX_MODEL_SYNTHESIS=deepseek-reasoner
CORTEX_OPENAI_BASE_URL=
CORTEX_OPENAI_API_KEY=

# --- Dashboard auth (Constraint §10 — never expose unauthenticated) ----------
# Secret used to sign the operator session. Generate: `openssl rand -base64 32`
CORTEX_AUTH_SECRET=
# The single operator's login (self-hosted, single user).
CORTEX_OPERATOR_EMAIL=
# Argon2/bcrypt hash of the operator password (never store the plaintext).
CORTEX_OPERATOR_PASSWORD_HASH=

# --- Gmail adapter (Phase 1) --------------------------------------------------
# OAuth 2.0 client from Google Cloud Console. Scope: gmail.readonly (read-only V1).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/oauth/gmail/callback
# The refresh token from the one-time consent flow: `pnpm gmail:auth`.
# IMPORTANT: set the OAuth app to "In production", not "Testing", or Google
# expires this token after 7 days and ingestion silently stops.
GMAIL_REFRESH_TOKEN=
# Optional: Pub/Sub topic for push (only viable with a public endpoint / VPS).
# Leave empty to use incremental historyId polling (the robust default).
GMAIL_PUBSUB_TOPIC=

# --- IMAP adapter (Phase 1/3) -------------------------------------------------
# Generic password-auth mailbox (Fastmail, Yahoo, self-hosted, …). Use an
# app-specific password where the provider offers one. NOTE: this no longer
# works for Outlook.com — use the Outlook OAuth block below instead.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# --- Outlook.com / Microsoft 365 (IMAP over OAuth) ---------------------------
# Microsoft killed IMAP basic-auth / app passwords in 2026, so Outlook needs
# OAuth. Register an app at portal.azure.com (Azure Active Directory → App
# registrations): allow "personal Microsoft accounts", add a Web redirect URI
# matching OUTLOOK_REDIRECT_URI, and (optionally) a client secret. Then run
# `pnpm outlook:auth` to mint OUTLOOK_REFRESH_TOKEN. Read-only: the only scope
# requested is IMAP.AccessAsUser.All. When set, this takes the single IMAP slot.
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=http://localhost:3000/oauth/outlook/callback
OUTLOOK_REFRESH_TOKEN=
OUTLOOK_USER=
# 'common' (personal + work) or 'consumers' (personal only).
OUTLOOK_TENANT=common

# --- Google Calendar adapter (Phase 3) ---------------------------------------
# Reuses the Google OAuth client; scope: calendar.readonly.
GOOGLE_CALENDAR_ID=primary

# --- WhatsApp module (Phase 4 — read-only, isolated container) ---------------
# Local socket/HTTP the whatsmeow/Baileys sidecar exposes to CORTEX.
WHATSAPP_BRIDGE_URL=http://localhost:8080
WHATSAPP_BRIDGE_TOKEN=

# --- iMessage module (read-only macOS chat.db sidecar) -----------------------
# Runs on your Mac (see services/imessage-bridge). Reach it over Tailscale/localhost.
# The token here MUST match IMESSAGE_BRIDGE_TOKEN in the sidecar's environment.
IMESSAGE_BRIDGE_URL=http://localhost:8090
IMESSAGE_BRIDGE_TOKEN=
