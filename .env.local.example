# ============================================================================
# impact.com integration — environment template
# ----------------------------------------------------------------------------
# Copy this file to `.env.local` (which is gitignored) and fill in the blanks.
# NEVER commit real credentials. `.env.local` must never be tracked by git.
#
#   cp .env.local.example .env.local
#
# The two credential lines below are the ONLY thing blocking live calls.
# Paste them, then run: `npm run persona` then `npm run smoke`.
# ============================================================================

# --- CREDENTIALS (required for any live call) -------------------------------
# app.impact.com -> Settings -> Technical -> API.  HTTP Basic:
#   AccountSID = username,  AuthToken = password.
IMPACT_ACCOUNT_SID=
IMPACT_AUTH_TOKEN=

# --- PERSONA ----------------------------------------------------------------
# One of: brand | partner | agency.  Leave as the config default; the client
# auto-detects and will WARN if this contradicts the detected persona.
#   brand   -> /Advertisers/{SID}/...
#   partner -> /Mediapartners/{SID}/...   <-- this account (publisher)
#   agency  -> /Agencies/{SID}/...
IMPACT_PERSONA=partner

# --- API HOST & VERSIONING --------------------------------------------------
IMPACT_API_HOST=https://api.impact.com

# Pin API versions per persona. Confirm the current latest via each API's
# Changelog page before bumping — a version bump is a deliberate PR.
# NOTE: these values are UNVERIFIED against live docs in this build (egress to
# impact.com was blocked). Confirm on .../readme/versioning.md + changelog.md.
IMPACT_BRAND_VERSION=14
IMPACT_PARTNER_VERSION=16
IMPACT_AGENCY_VERSION=3

# How the version is applied to requests. VERIFY against .../versioning.md.
# One of: none | header | path
#   none   -> no version applied (impact.com's classic REST behaviour)
#   header -> sent as the `X-Api-Version` / Accept version header (name below)
#   path   -> inserted as a path segment after the base path
IMPACT_VERSION_STRATEGY=none
IMPACT_VERSION_HEADER=X-Api-Version

# --- DEFAULTS ---------------------------------------------------------------
DEFAULT_CURRENCY=SEK
DEFAULT_TIMEZONE=Europe/Stockholm
REGION_COMPLIANCE=EU_GDPR

# --- HTTP CLIENT TUNING -----------------------------------------------------
HTTP_TIMEOUT_MS=30000
HTTP_MAX_RETRIES=5
HTTP_BACKOFF_BASE_MS=500
HTTP_BACKOFF_MAX_MS=20000
HTTP_RETRY_AFTER_MAX_MS=60000   # cap on how long a server Retry-After may block us
LOG_LEVEL=info            # debug | info | warn | error

# --- DEFERRED (async report/export) JOB POLLING -----------------------------
DEFERRED_POLL_INTERVAL_MS=2000
DEFERRED_MAX_WAIT_MS=300000

# --- WRITE SAFETY -----------------------------------------------------------
# Default is dry-run: writes are logged, not sent. Pass --live on the CLI to
# actually fire, or set IMPACT_LIVE=1 (CLI flag wins).
IMPACT_LIVE=0

# --- DATABASE (sync target) -------------------------------------------------
# One of: supabase | postgres | sqlite | none
DB=supabase

# Supabase / Postgres connection (server-side only).
# Prefer the Supabase *pooler* connection string (IPv4; works on all networks).
# The direct db.<ref>.supabase.co host is IPv6-only and often unreachable.
DATABASE_URL=

# Optional: supply the DB password separately (RAW — no percent-encoding needed).
# When set, OMIT the password from DATABASE_URL, e.g.
#   DATABASE_URL=postgresql://postgres.<ref>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   DATABASE_PASSWORD=your$weird/password
DATABASE_PASSWORD=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# sqlite (only when DB=sqlite)
SQLITE_PATH=./data/impact.sqlite

# GDPR: TTL (days) after which synced click/action rows are purged.
DATA_RETENTION_DAYS=395

# --- WEBHOOKS / POSTBACKS ---------------------------------------------------
# Shared secret used to verify inbound postbacks. VERIFY the exact signature
# scheme against .../webhooks + webhook-security docs before trusting it live.
WEBHOOK_SIGNING_SECRET=
WEBHOOK_PORT=8787

# ============================================================================
# SVEE//TWIN — job-application digital twin (shares the DB above)
# ----------------------------------------------------------------------------
# The two knobs that do the most work are the THRESHOLD and the SALARY_FLOOR.
# ============================================================================

# Discard anything below this fit score (0–100). 68–79 = stretch, 80+ = prioritize.
TWIN_THRESHOLD=68

# Hard salary floor in the KB's unit (monthly SEK unless the KB says otherwise).
# Leave blank = unknown → comp is scored neutrally, never used to discard.
TWIN_SALARY_FLOOR=

# The whole safety model. 0 (default) = STAGE-ONLY: the twin does 100% of the
# work and queues every irreversible action for one-tap approval; the executor
# refuses to submit/login/send. 1 (or --live) only ever hands off an APPROVED
# action — it never bypasses an approval row.
TWIN_LIVE=0

# Cap on applications staged per run (anti spray-and-pray).
TWIN_MAX_STAGED=8

# Follow-up nudge delay for high-fit, no-reply applications (days).
TWIN_FOLLOWUP_DAYS=7

# Model for the tailoring/drafting LLM (the latest Opus by default).
TWIN_MODEL=claude-opus-4-8

# Anthropic key for the LIVE drafting path. Absent → deterministic, provably
# KB-bound cover letters (no fabricated numbers possible). Requires
# `npm install @anthropic-ai/sdk`.
ANTHROPIC_API_KEY=

# Optional external KB JSON (versioned file the agent reads each run). Absent →
# the bundled src/twin/kb.data.ts is used.
TWIN_KB_PATH=

# Which of Svee's mailboxes email applications/replies are staged for (gmail|outlook).
TWIN_EMAIL_PROVIDER=gmail

# Default channel for recruiter messages/follow-ups (email|linkedin|whatsapp).
# A reply goes back on the channel it arrived on when known; otherwise this default.
TWIN_MESSAGE_CHANNEL=email
